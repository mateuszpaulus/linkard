# Local secrets for `docker compose up` in /backend.
# Copy to `.env` (same directory) and fill in real test values.
# NEVER commit the real .env — it's gitignored.

# ── Stripe (test mode) ──────────────────────────────────────
# Dashboard: https://dashboard.stripe.com (toggle "Test mode" top-right)
# Developers → API keys → Secret key (starts with sk_test_…)
STRIPE_SECRET_KEY=sk_test_...

# Products → create a recurring product → copy Price ID (price_…)
STRIPE_PRICE_ID=price_...

# Webhook signing secret. Two ways to get it:
#   a) Stripe CLI: `stripe listen --forward-to http://localhost:8080/api/webhooks/stripe`
#      prints whsec_… on start.
#   b) Dashboard → Developers → Webhooks → add endpoint → reveal signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Resend (optional — leave empty to skip emails) ──────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── App ─────────────────────────────────────────────────────
APP_FRONTEND_URL=http://localhost:3000
